# ── Canonical site URL (used for sitemap, robots.txt, hreflang & Open Graph) ──
# Must match the verified Search Console property domain: https://vensailabs.in
NEXT_PUBLIC_SITE_URL=https://vensailabs.in

# Lead intake endpoint exposed by crm.vensailabs.in
CRM_LEADS_URL=https://crm.vensailabs.in/api/public/leads

# Shared secret; must match WEBSITE_LEADS_API_KEY on the CRM. Never prefix with NEXT_PUBLIC_.
CRM_LEADS_API_KEY=replace-with-a-long-random-secret
